NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_CONTRACT_ADDRESS=
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Optional public app metadata used for canonical URLs and SEO.
NEXT_PUBLIC_SITE_URL=https://stellartrustescrow.com

# Stellar ecosystem endpoints used by wallet, liquidity, and market widgets.
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_USDC_ISSUER=

# WebSocket endpoint for live updates; leave unset to derive it from NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# ── Multi-Currency ─────────────────────────────────────────────────────────────
# Exchange rate API endpoint (default: open.er-api.com — free, no key required)
NEXT_PUBLIC_EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest/USD
# How long to cache exchange rates in the browser (ms, default 1 hour)
NEXT_PUBLIC_FX_CACHE_TTL_MS=3600000

# Optional analytics endpoint for frontend telemetry and performance reporting.
NEXT_PUBLIC_ANALYTICS_URL=

# Legacy/auxiliary API base for data export or other non-primary services.
NEXT_PUBLIC_API_BASE=http://localhost:3001

# ── Sentry Error Tracking ──────────────────────────────────────────────────────
# Get your DSN from https://sentry.io → Project Settings → Client Keys
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENV=development
NEXT_PUBLIC_SENTRY_RELEASE=
# Server-only — used to upload source maps during build
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
